<UserControl x:Class="AiDownloadManager.Presentation.Controls.SpeedGraphControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <TextBlock Text="Download speed — last 60 seconds"
                   FontSize="11" Foreground="#666666" Margin="2,0,0,0"
                   VerticalAlignment="Top" HorizontalAlignment="Left" />
        <Canvas x:Name="GraphCanvas" Margin="0,18,0,0" Background="Transparent">
            <Line x:Name="Baseline" Stroke="#DDDDDD" StrokeThickness="1" />
            <Polyline x:Name="GraphLine" Stroke="#0078D4" StrokeThickness="2"
                      StrokeLineJoin="Round" />
        </Canvas>
    </Grid>
</UserControl>
