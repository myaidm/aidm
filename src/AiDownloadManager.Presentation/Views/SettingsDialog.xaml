<Window x:Class="AiDownloadManager.Presentation.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiDownloadManager.Presentation"
        Title="Settings" Width="540" Height="470"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Downloads" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Download folder" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DownloadFolder}"
                 Height="28" VerticalContentAlignment="Center" IsReadOnly="True"
                 AutomationProperties.Name="Download folder" />
        <Button Grid.Row="1" Grid.Column="2" Content="Browse…" Margin="8,0,0,0"
                Padding="12,4" Click="BrowseFolderButton_Click" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Default connections" VerticalAlignment="Center" Margin="0,12,0,0" />
        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,12,0,0" Width="90"
                  HorizontalAlignment="Left" x:Name="ConnectionsCombo"
                  SelectedItem="{Binding DefaultConnections}"
                  AutomationProperties.Name="Default connections" />
        <TextBlock Grid.Row="2" Grid.Column="2" Text="1–32" Margin="8,12,0,0"
                   VerticalAlignment="Center" Foreground="#666666" FontSize="11" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Speed limit (KB/s)" VerticalAlignment="Center" Margin="0,12,0,0" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,12,0,0" Width="120"
                 HorizontalAlignment="Left" Height="28" VerticalContentAlignment="Center"
                 Text="{Binding SpeedLimitText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Speed limit in kilobytes per second" />
        <TextBlock Grid.Row="3" Grid.Column="2" Text="empty = unlimited" Margin="8,12,0,0"
                   VerticalAlignment="Center" Foreground="#666666" FontSize="11" />
        <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="Speed limits are stored but not yet enforced — enforcement arrives in a later phase."
                   FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,4,0,0" />

        <CheckBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                  Content="Minimize to system tray instead of closing"
                  IsChecked="{Binding MinimizeToTray}"
                  AutomationProperties.Name="Minimize to system tray" />

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="Antivirus" FontWeight="Bold" FontSize="13" Margin="0,16,0,8" />
        <Grid Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Scanner executable" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding AntivirusScannerPath}"
                     Height="28" VerticalContentAlignment="Center" IsReadOnly="True"
                     AutomationProperties.Name="Antivirus scanner executable" />
            <Button Grid.Row="0" Grid.Column="2" Content="Browse…" Margin="8,0,0,0"
                    Padding="12,4" Click="BrowseScannerButton_Click" />
            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,12,0,0"
                      Content="Scan completed downloads with this scanner"
                      IsChecked="{Binding AntivirusEnabled}"
                      IsEnabled="{Binding CanEnableAntivirus}"
                      AutomationProperties.Name="Enable antivirus scanning" />
            <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                       Text="Antivirus scanning is not active in this build — this setting is reserved for the upcoming antivirus hook. Scanning is opt-in, runs only on completed downloads, and never executes downloaded files."
                       FontSize="11" Foreground="#666666" TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>

        <TextBlock Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   FontSize="12" Foreground="#C00000" Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

        <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Height="30" Margin="0,0,8,0"
                    IsCancel="True" Click="CancelButton_Click" />
            <Button Content="Save" Width="90" Height="30"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="SaveButton_Click" />
        </StackPanel>
    </Grid>
</Window>
