<Window x:Class="AiDownloadManager.Presentation.Views.AddUrlDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiDownloadManager.Presentation"
        Title="Add download" Width="540" Height="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Window.Resources>
        <local:StringNullOrEmptyToVisibilityConverter x:Key="StringToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="URL" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                 Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                 Height="28" VerticalContentAlignment="Center"
                 AutomationProperties.Name="Download URL" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="Enter an http, https, or ftp address."
                   FontSize="11" Foreground="#666666" Margin="0,4,0,10" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Save to folder" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DestinationFolder}"
                 Height="28" VerticalContentAlignment="Center" IsReadOnly="True"
                 AutomationProperties.Name="Destination folder" />
        <Button Grid.Row="2" Grid.Column="2" Content="Browse…" Margin="8,0,0,0"
                Padding="12,4" Click="BrowseButton_Click" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="File name" VerticalAlignment="Center" Margin="0,12,0,0" />
        <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,12,0,0"
                 Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}"
                 Height="28" VerticalContentAlignment="Center"
                 AutomationProperties.Name="File name" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Connections" VerticalAlignment="Center" Margin="0,12,0,0" />
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,12,0,0" Width="90"
                  HorizontalAlignment="Left" x:Name="ConnectionsCombo"
                  SelectedItem="{Binding Connections}"
                  AutomationProperties.Name="Connections" />
        <TextBlock Grid.Row="4" Grid.Column="2" Text="1–32" Margin="8,12,0,0"
                   VerticalAlignment="Center" Foreground="#666666" FontSize="11" />

        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding InfoMessage}" TextWrapping="Wrap"
                   FontSize="11" Foreground="#666666" Margin="0,12,0,0"
                   Visibility="{Binding InfoMessage, Converter={StaticResource StringToVis}}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                   Text="{Binding ErrorMessage}" TextWrapping="Wrap"
                   FontSize="12" Foreground="#C00000" Margin="0,8,0,0"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVis}}" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Width="90" Height="30" Margin="0,0,8,0"
                    IsCancel="True" Click="CancelButton_Click" />
            <Button Content="Start download" Width="130" Height="30"
                    Style="{StaticResource PrimaryButton}"
                    IsDefault="True" Click="StartButton_Click" />
        </StackPanel>
    </Grid>
</Window>
